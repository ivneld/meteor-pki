#!/usr/bin/env bash
[ "${SKIP_ARCH_REVIEW:-0}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)"
command -v pi >/dev/null 2>&1 || { echo "pi 가 없어 아키텍처 리뷰를 건너뜁니다. 설치: npm i -g @earendil-works/pi-coding-agent" >&2; exit 0; }
pi --approve -p --no-session "/arch-review" < /dev/null
code=$?
if [ "$code" = 1 ]; then
    echo >&2
    echo "아키텍처 리뷰 BLOCK. findings 를 해결하거나 ADR 로 예외를 기록한 뒤 다시 푸시하세요. (건너뛰기: SKIP_ARCH_REVIEW=1)" >&2
    exit 1
fi
exit 0
